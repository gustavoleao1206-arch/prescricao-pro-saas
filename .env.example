# =============================================================================
# Prescrição Pro — Exemplo de variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com valores REAIS.
# NUNCA versione o arquivo `.env`. NUNCA exponha estes valores no frontend.
# Somente variáveis prefixadas com NEXT_PUBLIC_ são expostas ao navegador.
# =============================================================================

# --- Aplicação --------------------------------------------------------------
NODE_ENV=development
APP_NAME="Prescrição Pro"
# URL pública da aplicação (usada em e-mails, callbacks e cookies).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Banco de dados (PostgreSQL) --------------------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=postgresql://ptp:ptp@localhost:5432/prescricao_tributaria?schema=public

# --- Autenticação / Sessão --------------------------------------------------
# Segredo para assinar tokens de sessão (JWT). Gere com: openssl rand -base64 48
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Tempo de vida da sessão em segundos (padrão 7 dias). É o prazo ABSOLUTO: a
# sessão morre nele, tenha sido usada ou não.
SESSION_MAX_AGE=604800
# Minutos de INATIVIDADE que encerram a sessão — coisa diferente do prazo acima:
# mede quanto tempo faz que ninguém usa. É o que protege a tela logada deixada
# aberta. Zero desliga a regra.
SESSION_IDLE_MINUTES=30
# Idem, para quem é da EQUIPE (administrador, revisor e suporte): prazo mais curto
# porque a tela deles mostra dado de OUTRAS pessoas — o revisor lê os autos
# inteiros, e do painel de administração se apaga conta, se libera acesso à mão e
# se encerra caso de dinheiro.
# Pôr um valor MAIOR que o do cliente não tem efeito — o código toma o menor.
SESSION_IDLE_MINUTES_EQUIPE=10
# Chave de 32 bytes (base64) para criptografia de campos sensíveis em repouso.
# Gere com: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=troque-por-uma-chave-de-32-bytes-base64

# --- Provedor de Inteligência Artificial ------------------------------------
# Provedor ativo: "anthropic" (recomendado) ou "openai".
AI_PROVIDER=anthropic
# Anthropic (Claude) — modelo recomendado para produção.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI (alternativa).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Limite de tokens por análise (proteção de custo).
AI_MAX_OUTPUT_TOKENS=8000
# Páginas transcritas em paralelo no OCR (1 a 8). Padrão 4: corta o tempo de um
# processo digitalizado grande para ~metade sem saturar a máquina.
OCR_CONCORRENCIA=4
# Cotação do dólar usada para ESTIMAR o custo de API em reais no painel admin de
# custos (Admin › Custos e receita). Não afeta cobrança do cliente; é indicador
# interno. Ajuste conforme o câmbio; se ausente, usa 5,60.
USD_BRL=5.60

# --- Armazenamento de documentos --------------------------------------------
# Driver: "local" (dev) ou "s3" (produção — S3/R2/MinIO compatível).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Configuração S3 (quando STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Validade (segundos) das URLs temporárias de download.
STORAGE_SIGNED_URL_TTL=300

# --- E-mail transacional ----------------------------------------------------
# Driver: "console" (dev, imprime no log), "resend" ou "smtp".
EMAIL_DRIVER=console
EMAIL_FROM="Prescrição Pro <no-reply@seu-dominio.com>"
# Destino dos ALERTAS OPERACIONAIS: dinheiro que entrou sem conta identificada,
# cobrança recebida depois do cancelamento. Vazia, o alerta vai para o contato do
# fornecedor (src/lib/fornecedor.ts). Nunca fica sem destino.
OPERACAO_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Pagamento (Asaas) ------------------------------------------------------
# Forma de pagamento ativa do produto. Quando ASAAS_API_KEY está definida, o
# botão "Assinar" cria um checkout hospedado no Asaas (o cliente informa CPF e
# escolhe PIX/cartão na página do Asaas). Ver ASAAS.md.
# Ambiente: "sandbox" (teste, sem cobrança real) ou "production".
ASAAS_ENV=sandbox
# Chave de API do Asaas (Configurações → Integrações → Chave de API/Access Token).
# A chave de sandbox e a de produção são DIFERENTES.
ASAAS_API_KEY=
# Token definido ao criar o webhook no Asaas; validado no header
# 'asaas-access-token' de cada evento recebido. Entre 32 e 255 caracteres.
ASAAS_WEBHOOK_TOKEN=
# (Opcional) Sobrescreve a URL base da API, caso o Asaas mude o domínio.
ASAAS_API_BASE_URL=

# --- Segurança / Rate limiting ----------------------------------------------
# Máximo de requisições por janela para rotas sensíveis.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
# Máximo de tentativas de login antes do bloqueio temporário.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Uso justo do agente por usuário (barra automação/flood sem afetar uso humano).
AGENT_RATE_MAX=30
AGENT_RATE_WINDOW_SECONDS=60

# --- Fila / Processamento assíncrono ----------------------------------------
# sync   = processa na requisição (padrão; simples/serverless)
# async  = fire-and-forget no processo (retorna rápido; exige servidor persistente)
# bullmq = fila Redis + worker dedicado (produção; rode `npm run worker`)
QUEUE_DRIVER=sync
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2
QUEUE_JOB_ATTEMPTS=3

# --- Uploads ----------------------------------------------------------------
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_FILES=20
# Só os formatos que a extração de texto realmente processa. DOCX e XLSX estavam
# nesta lista: o upload aceitava o arquivo e a extração devolvia zero página, então
# o cliente via "documento recebido" e a análise concluía sobre nada. A trava final
# é MIME_PROCESSAVEIS, em src/lib/documents.ts.
UPLOAD_ALLOWED_MIME="application/pdf,image/png,image/jpeg"

# --- Observabilidade (opcional) ---------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# --- Administrador inicial (usado pelo seed) --------------------------------
# A senha fica VAZIA de propósito: preencha com uma senha SUA antes de rodar
# `npm run db:seed` — vazia, o seed recusa rodar. Este arquivo é versionado;
# senha escrita aqui é senha conhecida.
# Em produção (NODE_ENV=production) o seed também recusa as senhas de
# demonstração conhecidas, senha com menos de 12 caracteres ou sem maiúscula,
# minúscula, número e símbolo, e SEED_DEMO=true (ver prisma/seed-guarda.ts).
SEED_ADMIN_EMAIL=admin@prescricaopro.local
SEED_ADMIN_PASSWORD=
# Senha das contas de demonstração (cliente, revisor e suporte), criadas só fora
# de produção. Também VAZIA de propósito: sem ela o seed recusa criar as contas
# (ou rode com SEED_DEMO=false).
SEED_DEMO_PASSWORD=
